# Copy to .env and adjust for local development. Never commit .env.
# Docker Compose reads .env automatically. For the backend, export the
# variables in your shell first: set -a; . ./.env; set +a

# PostgreSQL connection used by the backend and by docker-compose.yml.
# Generate a local password, for example: openssl rand -hex 24
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tracelite
SPRING_DATASOURCE_USERNAME=tracelite
SPRING_DATASOURCE_PASSWORD=

# Host port that docker-compose.yml publishes PostgreSQL on (default: 5432).
# If you change it, update the port in SPRING_DATASOURCE_URL as well.
TRACELITE_DB_PORT=5432

# HTTP port for the backend when run with ./mvnw or java -jar (default: 8080)
SERVER_PORT=8080

# Host port that docker-compose.yml publishes the backend container on (default: 8080).
# Inside the container the backend always listens on 8080.
TRACELITE_BACKEND_PORT=8080

# API keys (see docs/security.md). Generate each key with: openssl rand -hex 32
# Requests to /api/** are rejected until the matching key is set.
# Management key: lists, reads, resolves and reopens issues. Empty disables it.
TRACELITE_SECURITY_MANAGEMENTKEY=
# Ingestion key for one application. Add further applications as _1_, _2_, ...
# TRACELITE_SECURITY_PROJECTS_0_APPLICATION=checkout-service
# TRACELITE_SECURITY_PROJECTS_0_INGESTIONKEY=

# Browser origins allowed to call the API, comma-separated (default: none).
# For the dashboard dev server use http://localhost:5173
TRACELITE_SECURITY_ALLOWEDORIGINS=

# Console log format (default: plain text). Set to ecs or logstash for JSON lines.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
