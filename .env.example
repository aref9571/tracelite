# Copy to .env and adjust for local development. Never commit .env.
# Docker Compose reads .env automatically. For the backend, export the
# variables in your shell first: set -a; . ./.env; set +a

# PostgreSQL connection used by the backend and by docker-compose.yml.
# Generate a local password, for example: openssl rand -hex 24
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tracelite
SPRING_DATASOURCE_USERNAME=tracelite
SPRING_DATASOURCE_PASSWORD=

# Host port that docker-compose.yml publishes PostgreSQL on (default: 5432).
# If you change it, update the port in SPRING_DATASOURCE_URL as well.
TRACELITE_DB_PORT=5432

# HTTP port for the backend (default: 8080)
SERVER_PORT=8080
